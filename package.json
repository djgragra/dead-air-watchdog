{
  "name": "dead-air-watchdog",
  "productName": "Dead Air Watchdog",
  "version": "26.11.7",
  "description": "Monitors sound cards and Icecast/Shoutcast streams with a native audio engine and alerts by email and Telegram when they stay silent",
  "main": "main.js",
  "type": "module",
  "author": "Graziano Melzi <hello@onairgarage.com> (https://onairgarage.com)",
  "homepage": "https://onairgarage.com/tools/dead-air-watchdog/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djgragra/dead-air-watchdog.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test dev/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "engine": "cargo build --release --manifest-path engine/Cargo.toml"
  },
  "dependencies": {
    "net-snmp": "^3.29.3",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.onairgarage.deadairwatchdog",
    "productName": "Dead Air Watchdog",
    "publish": null,
    "files": [
      "main.js",
      "preload.cjs",
      "sound-preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "CHANGELOG.md",
      "package.json"
    ],
    "afterPack": "dev/sign-adhoc.cjs",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Dead-Air-Watchdog-Setup-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "Dead-Air-Watchdog-${version}-${arch}.dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Dead Air Watchdog measures the level of the selected audio input to detect silence. Audio is never recorded, saved or sent anywhere."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/linux-icons",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Dead Air Watchdog"
    },
    "extraResources": [
      {
        "from": "engine/dist/${os}-${arch}",
        "to": "engine"
      }
    ],
    "appImage": {
      "artifactName": "Dead-Air-Watchdog-${version}.AppImage"
    },
    "deb": {
      "artifactName": "Dead-Air-Watchdog-${version}.deb",
      "depends": [
        "libasound2 | libasound2t64",
        "libgtk-3-0 | libgtk-3-0t64",
        "libnss3",
        "libxss1 | libxss1t64",
        "libxtst6",
        "libnotify4",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  }
}
